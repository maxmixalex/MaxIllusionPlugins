<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="IllusionMods" value="https://pkgs.dev.azure.com/IllusionMods/Nuget/_packaging/IllusionMods/nuget/v3/index.json" />
    <add key="BepInExLibs" value="https://pkgs.dev.azure.com/bepinex/BepInEx/_packaging/BepInExLibs/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="HarmonyX" />
      <package pattern="MonoMod.*" />
      <package pattern="Mono.Cecil" />
    </packageSource>
    <packageSource key="IllusionMods">
      <package pattern="IllusionLibs.*" />
      <package pattern="IllusionModdingAPI.*" />
      <package pattern="ExtensibleSaveFormat.*" />
      <package pattern="Sideloader.*" />
      <package pattern="KoikatuCompatibilityAnalyzer" />
    </packageSource>
    <packageSource key="BepInExLibs">
      <package pattern="BepInEx.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
